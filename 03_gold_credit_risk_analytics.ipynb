   "metadata": {},
   "source": [
    "# 03 — Gold | Credit Risk Analytics\n",
    "**Microsoft Fabric · Lakehouse · PySpark / Spark SQL**\n",
    "\n",
    "Objetivo: criar tabelas analíticas agregadas e um modelo dimensional simples para consumo no Power BI.\n",
    "\n",
    "A camada Gold apresenta métricas descritivas sobre `loan_status`. Não constitui um modelo de aprovação de crédito nem uma previsão individual."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "21807f91",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.sql import functions as F\n",
    "from pyspark.sql.window import Window\n",
    "\n",
    "SILVER_TABLE = \"silver_credit_risk\"\n",
    "GOLD_KPI_TABLE = \"gold_credit_risk_kpis\"\n",
    "GOLD_GRADE_TABLE = \"gold_risk_by_grade\"\n",
    "GOLD_INTENT_TABLE = \"gold_risk_by_loan_intent\"\n",
    "GOLD_AGE_TABLE = \"gold_risk_by_age_group\"\n",
    "GOLD_FACT_TABLE = \"gold_fact_loans\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8a78d0f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "df = spark.table(SILVER_TABLE)\n",
    "\n",
    "# Dimensão derivada de faixa etária para análise descritiva\n",
    "df = df.withColumn(\n",
    "    \"age_group\",\n",
    "    F.when(F.col(\"person_age\") < 25, \"Under 25\")\n",
    "     .when(F.col(\"person_age\") < 35, \"25-34\")\n",
    "     .when(F.col(\"person_age\") < 45, \"35-44\")\n",
    "     .when(F.col(\"person_age\") < 55, \"45-54\")\n",
    "     .otherwise(\"55+\")\n",
    ")\n",
    "\n",
    "# Indicador categórico, sem inferir score de crédito\n",
    "df = df.withColumn(\n",
    "    \"loan_outcome\",\n",
    "    F.when(F.col(\"loan_status\") == 1, \"Default\")\n",
    "     .otherwise(\"Non-default\")\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "870751e4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fato de empréstimos (campos de análise disponíveis)\n",
    "fact_cols = [\n",
    "    c for c in [\n",
    "        \"person_age\", \"person_income\", \"person_home_ownership\",\n",
    "        \"person_emp_length\", \"loan_intent\", \"loan_grade\",\n",
    "        \"loan_amnt\", \"loan_int_rate\", \"loan_status\",\n",
    "        \"loan_percent_income\", \"cb_person_default_on_file\",\n",
    "        \"cb_person_cred_hist_length\", \"age_group\", \"loan_outcome\"\n",
    "    ] if c in df.columns\n",
    "]\n",
    "gold_fact = df.select(*fact_cols)\n",
    "\n",
    "(\n",
    "    gold_fact.write.format(\"delta\")\n",
    "    .mode(\"overwrite\").option(\"overwriteSchema\", \"true\")\n",
    "    .saveAsTable(GOLD_FACT_TABLE)\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3368b304",
   "metadata": {},
   "outputs": [],
   "source": [
    "# KPIs globais\n",
    "gold_kpis = df.agg(\n",
    "    F.count(\"*\").alias(\"total_loans\"),\n",
    "    F.sum(\"loan_status\").alias(\"defaulted_loans\"),\n",
    "    F.avg(\"loan_amnt\").alias(\"average_loan_amount\"),\n",
    "    F.sum(\"loan_amnt\").alias(\"total_loan_amount\"),\n",
    "    F.avg(\"person_income\").alias(\"average_person_income\"),\n",
    "    F.avg(\"loan_int_rate\").alias(\"average_interest_rate\"),\n",
    "    F.avg(\"loan_percent_income\").alias(\"average_loan_to_income\")\n",
    ").withColumn(\n",
    "    \"default_rate\",\n",
    "    F.col(\"defaulted_loans\") / F.col(\"total_loans\")\n",
    ").withColumn(\"_gold_created_at\", F.current_timestamp())\n",
    "\n",
    "gold_kpis.write.format(\"delta\").mode(\"overwrite\").option(\"overwriteSchema\",\"true\").saveAsTable(GOLD_KPI_TABLE)\n",
    "display(gold_kpis)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b7714043",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Incumprimento por classificação do empréstimo\n",
    "gold_grade = (\n",
    "    df.groupBy(\"loan_grade\")\n",
    "    .agg(\n",
    "        F.count(\"*\").alias(\"total_loans\"),\n",
    "        F.sum(\"loan_status\").alias(\"defaulted_loans\"),\n",
    "        F.avg(\"loan_amnt\").alias(\"average_loan_amount\"),\n",
    "        F.avg(\"loan_int_rate\").alias(\"average_interest_rate\")\n",
    "    )\n",
    "    .withColumn(\"default_rate\", F.col(\"defaulted_loans\") / F.col(\"total_loans\"))\n",
    "    .orderBy(\"loan_grade\")\n",
    ")\n",
    "gold_grade.write.format(\"delta\").mode(\"overwrite\").option(\"overwriteSchema\",\"true\").saveAsTable(GOLD_GRADE_TABLE)\n",
    "display(gold_grade)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fffe5dbf",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Incumprimento por finalidade do empréstimo\n",
    "gold_intent = (\n",
    "    df.groupBy(\"loan_intent\")\n",
    "    .agg(\n",
    "        F.count(\"*\").alias(\"total_loans\"),\n",
    "        F.sum(\"loan_status\").alias(\"defaulted_loans\"),\n",
    "        F.avg(\"loan_amnt\").alias(\"average_loan_amount\")\n",
    "    )\n",
    "    .withColumn(\"default_rate\", F.col(\"defaulted_loans\") / F.col(\"total_loans\"))\n",
    "    .orderBy(F.desc(\"default_rate\"))\n",
    ")\n",
    "gold_intent.write.format(\"delta\").mode(\"overwrite\").option(\"overwriteSchema\",\"true\").saveAsTable(GOLD_INTENT_TABLE)\n",
    "display(gold_intent)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "07a90f25",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Incumprimento por faixa etária\n",
    "gold_age = (\n",
    "    df.groupBy(\"age_group\")\n",
    "    .agg(\n",
    "        F.count(\"*\").alias(\"total_loans\"),\n",
    "        F.sum(\"loan_status\").alias(\"defaulted_loans\"),\n",
    "        F.avg(\"person_income\").alias(\"average_income\")\n",
    "    )\n",
    "    .withColumn(\"default_rate\", F.col(\"defaulted_loans\") / F.col(\"total_loans\"))\n",
    ")\n",
    "gold_age.write.format(\"delta\").mode(\"overwrite\").option(\"overwriteSchema\",\"true\").saveAsTable(GOLD_AGE_TABLE)\n",
    "display(gold_age)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "01785a41",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Verificação final das tabelas Gold\n",
    "for table_name in [\n",
    "    GOLD_KPI_TABLE, GOLD_GRADE_TABLE, GOLD_INTENT_TABLE,\n",
    "    GOLD_AGE_TABLE, GOLD_FACT_TABLE\n",
    "]:\n",
    "    print(table_name, spark.table(table_name).count())"
   ]
  },
  {
